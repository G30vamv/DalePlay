{
  "manifest_version": 3,
  "name": "DalePlay",
  "description": "Sincroniza la reproducción en una sala privada.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_title": "DalePlay", "default_popup": "popup.html"}
}
